# MySQL database must exist first: CREATE DATABASE pharma_sh_center CHARACTER SET utf8mb4;
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pharma_sh_center
DB_USER=pharma_app
DB_PASSWORD=CHANGE_ME
# Optional alternative to DB_HOST/PORT/USER/PASSWORD/NAME; URL-encode credentials:
# DATABASE_URL=mysql://user:password@host:3306/pharma_sh_center
DB_SSL=false
# For online MySQL set DB_SSL=true; use provider root CA if required:
# DB_SSL_CA="-----BEGIN CERTIFICATE-----..."
PORT=3000
HOST=0.0.0.0
COOKIE_SECURE=false
# Leave unset to accept the same origin used by each LAN browser.
# For an HTTPS reverse proxy/cloud deployment, set the exact public origin:
# APP_ORIGIN=https://pharma.example.com
CENTER_TIMEZONE=Asia/Riyadh
ADMIN_EMAIL=CHANGE_ME@example.com
ADMIN_NAME=مدير النظام
ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_4_OR_MORE_CHARACTERS
# Optional, server only:
GEMINI_API_KEY=

# Express: reuse two MySQL connections; connection wait limit in milliseconds.
DB_CONNECTION_LIMIT=2
DB_CONNECT_TIMEOUT_MS=30000
