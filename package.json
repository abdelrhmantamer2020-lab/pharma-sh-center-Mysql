{
  "name": "pharma-sh-center-mysql",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "node --import tsx server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "start": "node --import tsx server.ts",
    "db:init": "node --import tsx scripts/init-db.ts",
    "db:import": "node --import tsx scripts/import-firebase.ts",
    "db:export": "node --import tsx scripts/export-mysql.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test tests/*.integration.ts",
    "cloudflare:check": "npm run build && wrangler deploy --dry-run --outdir .worker-build",
    "cloudflare:deploy": "npm run build && wrangler deploy",
    "cloudflare:mysql55:check": "npm run build && wrangler deploy --config wrangler.mysql55.jsonc --dry-run --outdir .worker-build-mysql55",
    "cloudflare:mysql55:deploy": "npm run build && wrangler deploy --config wrangler.mysql55.jsonc"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "vite": "^8.3.0",
    "mysql2": "^3.13.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.0.0",
    "@cloudflare/workers-types": "^4.0.0"
  }
}
