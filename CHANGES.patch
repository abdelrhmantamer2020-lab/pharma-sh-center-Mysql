diff --git a/scripts/export-mysql.ts b/scripts/export-mysql.ts
new file mode 100644
index 0000000..28d35a9
--- /dev/null
+++ b/scripts/export-mysql.ts
@@ -0,0 +1,15 @@
+import 'dotenv/config';
+import fs from 'node:fs/promises';
+import { localDatabase, COLLECTIONS, list, rows, transaction } from '../backend/db';
+import { publicUser } from '../backend/auth';
+const output=process.argv[2];if(!output)throw new Error('Usage: npm run db:export -- backup.json (contains textual passwords and notification credentials; store securely)');
+const db=await localDatabase();
+try {
+  const result=await transaction(db,async()=>{
+    const collections:any={};for(const table of COLLECTIONS)collections[table]=await list(db,table);
+    collections.users=(await rows(db,'SELECT * FROM users')).map(u=>({...publicUser(u),password:u.password}));
+    const reportFiles=(await rows(db,'SELECT * FROM report_files')).map(f=>({id:f.id,user_id:f.user_id,language_code:f.language_code,contentBase64:Buffer.from(f.content).toString('base64')}));
+    return {backupVersion:'mysql-server-1',collections,doseAdministrations:(await rows(db,'SELECT * FROM dose_administrations')).map(d=>({...d,administration_date:d.administration_date instanceof Date?d.administration_date.toISOString().slice(0,10):d.administration_date})),reportFiles,createdAt:new Date().toISOString()};
+  });
+  await fs.writeFile(output,JSON.stringify(result,null,2),{mode:0o600,flag:'wx'});console.log('Export complete. Active sessions are deliberately excluded.');
+} finally {await db.end();}
diff --git a/scripts/generate-schema.py b/scripts/generate-schema.py
new file mode 100644
index 0000000..37357db
--- /dev/null
+++ b/scripts/generate-schema.py
@@ -0,0 +1,54 @@
+from pathlib import Path
+collections=['medicines','batches','dispense_records','residents','doctors','pharmaceutical_companies','behavior_logs','custom_side_effects','stock_audit_logs','security_settings','system_settings','settings','item_units','therapeutic_categories','user_sessions']
+sql='''-- MySQL 8.0+ / 8.4. Run against a dedicated, empty database using utf8mb4.
+-- JSON preserves existing clinical fields; frequently updated inventory uses typed columns.
+SET NAMES utf8mb4;
+CREATE TABLE IF NOT EXISTS schema_migrations (version INT PRIMARY KEY, applied_at TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3));
+CREATE TABLE IF NOT EXISTS users (
+ id VARCHAR(191) COLLATE utf8mb4_bin PRIMARY KEY,
+ email VARCHAR(254) NOT NULL UNIQUE, name VARCHAR(255) NOT NULL,
+ role ENUM('developer','admin','pharmacist','technician') NOT NULL,
+ password VARCHAR(256) NOT NULL, is_active BOOLEAN NOT NULL DEFAULT TRUE,
+ payload JSON NOT NULL, version BIGINT NOT NULL DEFAULT 1,
+ updated_at TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+CREATE TABLE IF NOT EXISTS sessions (
+ token_hash CHAR(64) CHARACTER SET ascii PRIMARY KEY,
+ user_id VARCHAR(191) COLLATE utf8mb4_bin NOT NULL UNIQUE,
+ client_id VARCHAR(191) NOT NULL, ip_address VARCHAR(255) NOT NULL, user_agent TEXT NOT NULL,
+ created_at DATETIME(3) NOT NULL, last_heartbeat DATETIME(3) NOT NULL, expires_at DATETIME(3) NOT NULL,
+ FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE,
+ INDEX idx_session_expiry (expires_at)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+CREATE TABLE IF NOT EXISTS login_attempts (
+ attempt_key CHAR(64) CHARACTER SET ascii PRIMARY KEY, failures INT NOT NULL DEFAULT 0, window_start DATETIME(3) NOT NULL
+) ENGINE=InnoDB;
+'''
+for c in collections:
+ extra='''quantity DECIMAL(14,4) NOT NULL DEFAULT 0, price DECIMAL(14,4) NOT NULL DEFAULT 0,
+ expiry_date DATE NOT NULL, is_controlled BOOLEAN NOT NULL DEFAULT FALSE,
+ CHECK(quantity >= 0), CHECK(price >= 0), INDEX idx_medicine_expiry(expiry_date),
+ ''' if c=='medicines' else ''
+ if c in ['item_units','therapeutic_categories']:
+  extra="lookup_name VARCHAR(191) GENERATED ALWAYS AS (JSON_UNQUOTE(JSON_EXTRACT(payload,'$.name'))) STORED, UNIQUE KEY idx_lookup_name(lookup_name),\n "
+ sql+=f'''CREATE TABLE IF NOT EXISTS `{c}` (
+ id VARCHAR(191) COLLATE utf8mb4_bin PRIMARY KEY, payload JSON NOT NULL,
+ {extra}version BIGINT NOT NULL DEFAULT 1,
+ updated_at TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+'''
+sql+='''CREATE TABLE IF NOT EXISTS dose_administrations (
+ resident_id VARCHAR(191) COLLATE utf8mb4_bin NOT NULL, dose_id VARCHAR(191) COLLATE utf8mb4_bin NOT NULL,
+ administration_date DATE NOT NULL, dispense_id VARCHAR(191) COLLATE utf8mb4_bin NOT NULL,
+ PRIMARY KEY(resident_id,dose_id,administration_date),
+ FOREIGN KEY (resident_id) REFERENCES residents(id), FOREIGN KEY (dispense_id) REFERENCES dispense_records(id)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+CREATE TABLE IF NOT EXISTS report_files (
+ id VARCHAR(191) PRIMARY KEY, user_id VARCHAR(191) COLLATE utf8mb4_bin NOT NULL,
+ language_code CHAR(2) NOT NULL, content LONGBLOB NOT NULL,
+ updated_at TIMESTAMP(3) NOT NULL DEFAULT CURRENT_TIMESTAMP(3) ON UPDATE CURRENT_TIMESTAMP(3),
+ FOREIGN KEY(user_id) REFERENCES users(id) ON DELETE CASCADE
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+INSERT IGNORE INTO schema_migrations(version) VALUES(1);
+'''
