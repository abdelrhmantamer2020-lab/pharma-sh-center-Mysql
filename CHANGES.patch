diff --git a/tests/proxy.test.ts b/tests/proxy.test.ts
new file mode 100644
index 0000000..504aa01
--- /dev/null
+++ b/tests/proxy.test.ts
@@ -0,0 +1,20 @@
+import {test} from 'node:test';
+import assert from 'node:assert/strict';
+import {createProxyWorker} from '../backend/worker-proxy';
+test('MySQL55 Cloudflare proxy requires an HTTPS Express origin',async()=>{
+ const worker=createProxyWorker();
+ for(const origin of ['','http://backend.example','https://user:password@backend.example','https://backend.example/path']){
+  const r=await worker.fetch(new Request('https://front.example/api/auth/me'),{API_ORIGIN:origin});assert.equal(r.status,503);
+ }
+});
+test('proxy forwards authentication and returns private uncached responses',async()=>{
+ let captured:any;
+ const worker=createProxyWorker((async(url:any,init:any)=>{captured={url:String(url),init};return new Response('{"user":{}}',{headers:{'Content-Type':'application/json','Set-Cookie':'pharma_session=secret; HttpOnly; Secure; Path=/'}});}) as any);
+ const req=new Request('https://front.example/api/auth/me?x=1',{headers:{Cookie:'pharma_session=token',Origin:'https://front.example','X-Pharma-Request':'1'}});
+ const r=await worker.fetch(req,{API_ORIGIN:'https://backend.example'});
+ assert.equal(captured.url,'https://backend.example/api/auth/me?x=1');assert.equal(captured.init.headers.get('Cookie'),'pharma_session=token');assert.equal(captured.init.headers.get('Origin'),'https://front.example');assert.equal(r.headers.get('Cache-Control'),'no-store');assert.match(r.headers.get('Set-Cookie')!,/HttpOnly/);
+});
+test('proxy errors do not disclose backend configuration',async()=>{
+ const worker=createProxyWorker((async()=>{throw new Error('private connection details');}) as any);
+ const r=await worker.fetch(new Request('https://front.example/api/data/medicines'),{API_ORIGIN:'https://backend.example'});assert.equal(r.status,502);assert.equal((await r.text()).includes('private connection'),false);
+});
