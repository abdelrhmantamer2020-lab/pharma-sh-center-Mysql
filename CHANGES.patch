+import 'dotenv/config';
+import fs from 'node:fs/promises';
+import { fileURLToPath } from 'node:url';
+import { localDatabase, rows, transaction, save } from '../backend/db';
+import { validatePassword } from '../backend/auth';
+const db=await localDatabase();
+try {
+  if(!process.argv.includes('--bootstrap-only')){
+    const sql=await fs.readFile(fileURLToPath(new URL(process.env.DB_COMPAT==='mysql55'?'../sql/001_initial_mysql55.sql':'../sql/001_initial.sql',import.meta.url)),'utf8');
+    for(const statement of sql.replace(/^\s*--.*$/gm,'').split(';').map(s=>s.trim()).filter(Boolean))await db.query(statement);
+    console.log('Schema initialized.');
+  }
+  if(!process.argv.includes('--schema-only')) {
+    const email=process.env.ADMIN_EMAIL?.trim().toLowerCase(), password=process.env.ADMIN_PASSWORD;
+    if(!email||!password)throw new Error('Set ADMIN_EMAIL and ADMIN_PASSWORD (4+ characters), or use --schema-only.');
+    const passwordValue=validatePassword(password);
+    await transaction(db,async()=>{
+      const existing=await rows(db,'SELECT id FROM users WHERE email=? FOR UPDATE',[email]);
+      if(existing.length){
+        if(!process.argv.includes('--reset-admin'))throw new Error('Account exists. Explicitly pass --reset-admin to reset this account.');
+        await db.execute("UPDATE users SET role='developer',password=?,is_active=1,version=version+1 WHERE id=?",[passwordValue,existing[0].id]);
+        await db.execute('DELETE FROM sessions WHERE user_id=?',[existing[0].id]);
+      } else {
+        const id=crypto.randomUUID();await db.execute("INSERT INTO users(id,email,name,role,password,payload) VALUES(?,?,?,'developer',?,?)",[id,email,process.env.ADMIN_NAME||'مدير النظام',passwordValue,JSON.stringify({uid:id,phone:''})]);
+      }
+    });
+    for(const [table,names] of [['item_units',['علبة','شريط','حبة','قرص','كبسولة','أمبولة','قارورة شراب','بخاخ']],['therapeutic_categories',['مسكنات وآلام','مضادات حيوية','أمراض مزمنة','فيتامينات ومكملات','Medical supplies','أخرى']]] as const){
+      const [count]=await rows(db,`SELECT COUNT(*) AS n FROM \`${table}\``);
+      if(Number(count.n)===0)for(const name of names)await save(db,table,{id:crypto.randomUUID(),name},undefined,true);
+    }
+    console.log('Developer account provisioned. No default password is shipped.');
+  }
+} finally {await db.end();}
