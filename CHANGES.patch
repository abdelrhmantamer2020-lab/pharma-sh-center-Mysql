+import { ApiError, COLLECTIONS, cleanPayload, validId, numberValue, one, rows, save, transaction, recordAdministration, type Database } from '../backend/db';
+const roles=['developer','admin','pharmacist','technician'];
+export function normalizeBackup(input:any){
+  const source=input.collections || input;
+  if(!source||typeof source!=='object'||Array.isArray(source))throw new Error('Expected collections object, not a Firestore binary export.');
+  const result:any={};
+  for(const table of [...COLLECTIONS,'users']){
+    const data=source[table] ?? (table==='pharmaceutical_companies'?source.companies:undefined) ?? [];
+    if(!Array.isArray(data))throw new Error(`${table}: expected an array`);
+    const ids=new Set<string>();
+    result[table]=data.map((raw:any)=>{
+      const id=validId(raw.id||raw.uid||raw.key);if(ids.has(id))throw new Error(`${table}: duplicate id ${id}`);ids.add(id);
+      if(table==='medicines'){numberValue(raw.quantity,'quantity');numberValue(raw.price,'price');if(!raw.expiryDate||!raw.unit||!raw.category||!raw.commercialName)throw new Error('Medicine fields missing');}
+      if(table==='users'&&(!roles.includes(raw.role)||!raw.email||!raw.name||typeof raw.password!=='string'||!raw.password||raw.password.length>256))throw new Error('User fields missing');
+      return {...raw,id};
+    });
+  }
+  // The old app commonly kept these values only in settings documents.
+  const settings=result.settings.find((s:any)=>s.id==='units_and_categories');
+  for(const [table,key] of [['item_units','units'],['therapeutic_categories','categories']])if(!result[table].length&&Array.isArray(settings?.[key]))result[table]=settings[key].map((name:string)=>({id:validId(name),name}));
+  const sideEffects=result.settings.find((s:any)=>s.id==='custom_side_effects')?.items;
+  if(!result.custom_side_effects.length&&Array.isArray(sideEffects))result.custom_side_effects=sideEffects.map((d:any)=>({...d,id:validId(d.id||d.key)}));
+  const emails=new Set<string>();for(const u of result.users){const email=u.email.trim().toLowerCase();if(emails.has(email))throw new Error(`Duplicate email ${email}`);emails.add(email);u.email=email;}
+  const medicineIds=new Set(result.medicines.map((m:any)=>m.id));const residentIds=new Set(result.residents.map((r:any)=>r.id));
+  const warnings:string[]=[];
+  for(const d of result.dispense_records){if(d.medicineId&&!medicineIds.has(d.medicineId))warnings.push(`Historical dispense ${d.id} references missing medicine`);if(d.residentId&&!residentIds.has(d.residentId))warnings.push(`Historical dispense ${d.id} references missing resident`);}
+  for(const r of result.residents)for(const dose of r.dosageSchedule||[])if(dose.quantity===undefined&&dose.qty===undefined)warnings.push(`Resident ${r.id}, dose ${dose.id}: numeric quantity must be reviewed before scheduled dispensing`);
+  return {collections:result,warnings,doseAdministrations:input.doseAdministrations||[],reportFiles:input.reportFiles||[]};
+}
+export async function importBackup(db:Database,backup:ReturnType<typeof normalizeBackup>){
+  return transaction(db,async()=>{
+    for(const table of [...COLLECTIONS,'users','dose_administrations','report_files']){const [n]=await rows(db,`SELECT COUNT(*) AS n FROM \`${table}\``);if(Number(n.n)!==0)throw new ApiError(409,`Target must be empty: ${table}`);}
+    const counts:any={};
+    for(const table of COLLECTIONS){for(const item of backup.collections[table])await save(db,table,item,undefined,true);counts[table]=backup.collections[table].length;}
+    for(const u of backup.collections.users){
+      if(typeof u.password!=='string'||!u.password||u.password.length>256)throw new Error('A textual password is required for every imported account. Export users from the original database.');
+      await db.execute('INSERT INTO users(id,email,name,role,password,is_active,payload) VALUES(?,?,?,?,?,?,?)',[u.id,u.email,u.name,u.role,u.password,u.isActive!==false&&u.status!=='inactive'?1:0,JSON.stringify(cleanPayload(u))]);
+    }counts.users=backup.collections.users.length;
+    for(const d of backup.doseAdministrations)await recordAdministration(db,d.resident_id,d.dose_id,d.administration_date,d.dispense_id);
+    for(const r of backup.reportFiles)await db.execute('INSERT INTO report_files(id,user_id,language_code,content) VALUES(?,?,?,?)',[r.id,r.user_id,r.language_code,Buffer.from(r.contentBase64,'base64')]);
+    for(const [table,count]of Object.entries(counts)){const [n]=await rows(db,`SELECT COUNT(*) AS n FROM \`${table}\``);if(Number(n.n)!==count)throw new Error(`Count mismatch for ${table}`);}
+    return counts;
+  });
+}
