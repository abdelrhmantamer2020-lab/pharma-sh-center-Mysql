+import 'dotenv/config';
+import fs from 'node:fs/promises';
+import { localDatabase } from '../backend/db';
+import { normalizeBackup, importBackup } from './import-data';
+const file=process.argv.slice(2).find(x=>!x.startsWith('--'));if(!file)throw new Error('Usage: npm run db:import -- backup.json [--apply]');
+const backup=normalizeBackup(JSON.parse(await fs.readFile(file,'utf8')));
+console.log(JSON.stringify({counts:Object.fromEntries(Object.entries(backup.collections).map(([k,v]:any)=>[k,v.length])),warnings:backup.warnings},null,2));
+if(process.argv.includes('--apply')){const db=await localDatabase();try{console.log('Imported and verified:',await importBackup(db,backup));console.log('Original textual passwords and account roles were preserved.');}finally{await db.end();}}
+else console.log('Validation only. No database changes. Add --apply to import into an EMPTY schema.');
