@@ -0,0 +1,50 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { validatePassword, verifyPassword, digest, publicUser, cookieToken, requireRole } from '../backend/auth';
+import { collectionName, numberValue, transaction, ApiError } from '../backend/db';
+import { normalizeBackup } from '../scripts/import-data';
+test('textual passwords are preserved; verification stays on server',()=>{
+  assert.equal(validatePassword('original-pass'),'original-pass');
+  assert.equal(verifyPassword('dev','dev'),true);assert.equal(verifyPassword('wrong','dev'),false);assert.equal(verifyPassword('dev-more','dev'),false);
+  assert.throws(()=>validatePassword('ab'));
+});
+test('session tokens use a digest and cookie parsing is exact',async()=>{
+  assert.equal((await digest('random-secret')).length,64);
+  assert.equal(cookieToken('x=1; pharma_session=abc; y=2'),'abc');
+  assert.equal(cookieToken('other_pharma_session=abc'),'');
+});
+test('normal user responses never expose database passwords',()=>{
+  const user=publicUser({id:'u',email:'u@example.com',name:'User',role:'admin',password:'original',payload:{password:'leak',passwordHash:'leak'},is_active:1,version:2});
+  assert.equal(user.password,undefined);assert.equal(user.passwordHash,undefined);assert.equal(user._version,2);
+});
+test('collection allowlist prevents arbitrary table/SQL access',()=>{
+  assert.equal(collectionName('medicines'),'medicines');assert.throws(()=>collectionName('users'));assert.throws(()=>collectionName('medicines`;DROP TABLE users;--'));
+});
+test('quantities reject negative, NaN and precision overflow',()=>{
+  for(const n of [-1,NaN,Infinity,'',null,0.00001])assert.throws(()=>numberValue(n,'qty'));
+  assert.throws(()=>numberValue(0,'qty',true));assert.equal(numberValue('0.1250','qty',true),.125);
+});
+test('roles are checked on the server',()=>{
+  assert.throws(()=>requireRole({role:'technician'},['developer','admin']));assert.doesNotThrow(()=>requireRole({role:'admin'},['developer','admin']));
+});
+test('failed transaction rolls back instead of committing partial stock',async()=>{
+  const calls:string[]=[];const db:any={beginTransaction:async()=>calls.push('begin'),commit:async()=>calls.push('commit'),rollback:async()=>calls.push('rollback')};
+  await assert.rejects(()=>transaction(db,async()=>{throw new Error('audit insert failed');}));assert.deepEqual(calls,['begin','rollback']);
+});
+test('migration preserves original IDs, text passwords and nested clinical fields',()=>{
+  const backup=normalizeBackup({collections:{users:[{uid:'legacy-u',name:'User',email:'ADMIN@EXAMPLE.COM',password:'dev',role:'developer'}],residents:[{id:'r1',name:'Resident',dosageSchedule:[{id:'d1',medicineId:'m1',quantity:1}]}],settings:[{id:'units_and_categories',units:['حبة'],categories:['مسكنات']}],doctors:[{id:'doctor',nameAr:'طبيب'}]}});
+  assert.equal(backup.collections.users[0].id,'legacy-u');assert.equal(backup.collections.users[0].password,'dev');assert.equal(backup.collections.users[0].email,'admin@example.com');
+  assert.equal(backup.collections.residents[0].dosageSchedule[0].id,'d1');assert.equal(backup.collections.item_units[0].name,'حبة');assert.equal(backup.collections.doctors.length,1);
+});
+test('migration rejects duplicate identifiers and duplicate emails',()=>{
+  assert.throws(()=>normalizeBackup({residents:[{id:'r'},{id:'r'}]}));
+  assert.throws(()=>normalizeBackup({users:[{id:'a',name:'A',email:'a@b.com',role:'admin',password:'test'},{id:'b',name:'B',email:'A@b.com',role:'admin',password:'test'}]}),/Duplicate email/);
+});
+
+import { validateOutboundUrl } from '../backend/outbound';
+test('messaging proxies reject arbitrary URLs, private targets and redirects to unapproved hosts',()=>{
+  assert.throws(()=>validateOutboundUrl('http://127.0.0.1/private'));
+  assert.throws(()=>validateOutboundUrl('https://attacker.invalid/steal'));
+  assert.throws(()=>validateOutboundUrl('https://secret@api.ultramsg.com/'));
+  assert.equal(validateOutboundUrl('https://script.google.com/macros/s/example/exec').hostname,'script.google.com');
+});
