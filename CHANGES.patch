+DB_PASSWORD=YOUR_ONLINE_DATABASE_PASSWORD
+# This MySQL 5.5 host was verified to lack TLS support.
+DB_SSL=false
+PORT=4500
+HOST=0.0.0.0
+COOKIE_SECURE=false
+CENTER_TIMEZONE=Asia/Riyadh
+# For Cloudflare HTTPS proxy use COOKIE_SECURE=true and set the FRONTEND origin:
+# APP_ORIGIN=https://your-pharma-frontend.workers.dev
+GEMINI_API_KEY=
+
+# Express: reuse two MySQL connections; connection wait limit in milliseconds.
+DB_CONNECTION_LIMIT=2
+DB_CONNECT_TIMEOUT_MS=30000
