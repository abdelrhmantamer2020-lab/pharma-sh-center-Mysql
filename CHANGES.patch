+async function request(path:string,method='GET',body?:any,token=cookie,extra:any={}){
+  const r=await fetch(base+path,{method,headers:{'Content-Type':'application/json','X-Pharma-Request':'1',...(token?{Cookie:token}:{}),...extra},...(body!==undefined?{body:JSON.stringify(body)}:{})});
+  return {status:r.status,data:await r.json(),cookie:r.headers.get('set-cookie')?.split(';')[0]};
+}
+before(async()=>{
+  if(!testUrl)return;
+  const name=new URL(testUrl).pathname.slice(1);if(!/^pharma_[a-z0-9_]*_test$/.test(name))throw new Error('Tests require a dedicated pharma_*_test database');
+  const db=await dbFactory();
+  try {
+    await db.query('SET FOREIGN_KEY_CHECKS=0');for(const row of await rows(db,'SHOW TABLES'))await db.query(`DROP TABLE \`${Object.values(row)[0]}\``);await db.query('SET FOREIGN_KEY_CHECKS=1');
+    const sql=await fs.readFile(new URL(process.env.DB_COMPAT==='mysql55'?'../sql/001_initial_mysql55.sql':'../sql/001_initial.sql',import.meta.url),'utf8');for(const statement of sql.replace(/^\s*--.*$/gm,'').split(';').map(x=>x.trim()).filter(Boolean))await db.query(statement);
+    await db.query('SET FOREIGN_KEY_CHECKS=0');for(const table of ['dose_administrations','report_files','sessions','login_attempts','users','medicines','residents','doctors','dispense_records','stock_audit_logs','user_sessions','item_units','therapeutic_categories','settings','security_settings','system_settings','batches','behavior_logs','pharmaceutical_companies','custom_side_effects'])await db.query(`TRUNCATE TABLE \`${table}\``);await db.query('SET FOREIGN_KEY_CHECKS=1');
+    for(const [id,role]of [['admin','developer'],['tech','technician'],['pharm','pharmacist']])await db.execute('INSERT INTO users(id,email,name,role,password,payload) VALUES(?,?,?,?,?,?)',[id,id+'@example.com',id,role,'original-'+id,'{}']);
+    await save(db,'medicines',{id:'m1',commercialName:'دواء اختبار',quantity:5,price:2.5,expiryDate:'2099-12-31',unit:'حبة',category:'اختبار'},undefined,true);
+    await save(db,'medicines',{id:'controlled',commercialName:'مقيد',quantity:5,price:2.5,expiryDate:'2099-12-31',isControlled:true,unit:'حبة',category:'اختبار'},undefined,true);
+    await save(db,'medicines',{id:'expired',commercialName:'منتهي',quantity:5,price:2.5,expiryDate:'2000-01-01',unit:'حبة',category:'اختبار'},undefined,true);
+    await save(db,'residents',{id:'r1',name:'مستفيد',dosageSchedule:[{id:'dose1',medicineId:'m1',quantity:1}]},undefined,true);
+  }finally{await db.end();}
+  const app=createApp({database:dbFactory,secureCookies:false,timezone:'Asia/Riyadh'});
+  server=await new Promise<any>(resolve=>{const s=app.listen(0,'127.0.0.1',()=>resolve(s));});base=`http://127.0.0.1:${server.address().port}`;
+  const login=await request('/api/auth/login','POST',{email:'admin@example.com',password:'original-admin',clientId:'test-admin'},'');assert.equal(login.status,200);cookie=login.cookie!;
+});
+after(async()=>{if(server)await new Promise<void>(resolve=>server.close(()=>resolve()));});
+suite('authentication rejects anonymous reads and CSRF requests',async()=>{
+  assert.equal((await request('/api/data/medicines','GET',undefined,'')).status,401);
+  assert.equal((await request('/api/data/medicines','POST',{},cookie,{'X-Pharma-Request':''})).status,403);
+  assert.equal((await request('/api/data/medicines','POST',{},cookie,{Origin:'https://attacker.invalid'})).status,403);
+  const users=await request('/api/users');assert.equal(users.status,200);assert.equal(JSON.stringify(users.data).includes('original-admin'),false);
+  const db=await dbFactory();try{assert.equal((await rows(db,"SELECT password FROM users WHERE id='admin'"))[0].password,'original-admin');}finally{await db.end();}
+});
+suite('concurrent dispensing cannot oversell; retrying a request never subtracts twice',async()=>{
+  const body={medicineId:'m1',residentId:'r1',actualQuantityDispensed:4,quantityDispensed:4};
+  const requests=await Promise.all([request('/api/dispenses','POST',body,cookie,{'Idempotency-Key':'stock-a'}),request('/api/dispenses','POST',body,cookie,{'Idempotency-Key':'stock-b'})]);
+  assert.deepEqual(requests.map(x=>x.status).sort(),[200,409]);
+  const success=requests.findIndex(x=>x.status===200);const retry=await request('/api/dispenses','POST',body,cookie,{'Idempotency-Key':success===0?'stock-a':'stock-b'});assert.equal(retry.status,200);assert.equal(retry.data.replayed,true);
+  const db=await dbFactory();try{assert.equal((await one(db,'medicines','m1')).quantity,1);assert.equal((await rows(db,'SELECT COUNT(*) AS n FROM dispense_records'))[0].n,1);assert.equal((await rows(db,'SELECT COUNT(*) AS n FROM stock_audit_logs'))[0].n,1);}finally{await db.end();}
+});
+suite('scheduled dose is committed once with its administration marker',async()=>{
+  const body={medicineId:'m1',residentId:'r1',doseId:'dose1',actualQuantityDispensed:1};
+  const results=await Promise.all([request('/api/dispenses','POST',body,cookie,{'Idempotency-Key':'dose-a'}),request('/api/dispenses','POST',body,cookie,{'Idempotency-Key':'dose-b'})]);
+  assert.deepEqual(results.map(x=>x.status).sort(),[200,409]);
+  const db=await dbFactory();try{assert.equal((await one(db,'medicines','m1')).quantity,0);assert.equal((await rows(db,'SELECT COUNT(*) AS n FROM dose_administrations'))[0].n,1);assert.equal((await one(db,'residents','r1')).dosageSchedule[0].checkedToday,true);}finally{await db.end();}
+});
+suite('technician cannot change units/categories, manage users or dispense controlled drugs',async()=>{
+  const login=await request('/api/auth/login','POST',{email:'tech@example.com',password:'original-tech',clientId:'test-tech'},'');const token=login.cookie!;
