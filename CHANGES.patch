--- /dev/null
+++ b/windows/Install.cmd
@@ -0,0 +1,22 @@
+@echo off
+setlocal
+cd /d "%~dp0.."
+where node >nul 2>&1
+if errorlevel 1 (
+  echo Install Node.js 24 LTS first, then run this file again.
+  pause
+  exit /b 1
+)
+if not exist .env copy .env.example .env >nul
+echo Edit .env with your MySQL details before initializing the database.
+call npm ci
+if errorlevel 1 goto failed
+call npm run build
+if errorlevel 1 goto failed
+echo Ready. Read README_AR.md for database initialization and data import.
+pause
+exit /b 0
+:failed
+echo Installation failed. Read the error above.
+pause
+exit /b 1
