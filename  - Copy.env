# قاعدة البيانات الأونلاين
DB_COMPAT=mysql55
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pharma_sh_center
DB_USER=root
DB_PASSWORD=1234

# الخادم الحالي لا يدعم SSL
DB_SSL=false

# إعدادات الاتصال والأداء
DB_CONNECTION_LIMIT=2
DB_CONNECT_TIMEOUT_MS=30000

# تشغيل البرنامج
PORT=4500
HOST=0.0.0.0
NODE_ENV=production

# جلسة الدخول عبر localhost
COOKIE_SECURE=false

# توقيت المركز
CENTER_TIMEZONE=Asia/Riyadh

# اختياري
GEMINI_API_KEY=